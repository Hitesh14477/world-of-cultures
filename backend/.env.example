PORT=5001
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/world-of-cultures
FRONTEND_ORIGIN=http://localhost:5173
ADMIN_USERNAME=
# Run `npm run admin:set-password` from backend/ to write a scrypt hash locally.
ADMIN_PASSWORD_HASH=
# Set locally to a random value with at least 32 characters; never commit it.
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Required for regular accounts; replace with a random value, distinct from the admin secret.
USER_SESSION_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
# The country import is currently blocked by its source-policy gate. Do not
# run it until persistent storage is explicitly approved in the policy registry.
REST_COUNTRIES_API_KEY=
# Offline REST Countries snapshots are subject to the same gate and may not be
# used to bypass source retention restrictions.
# COUNTRIES_SOURCE_FILE=./data/countries-v5.json
# Optional backend-only Gemini draft generation key. Never put this in the frontend env.
GEMINI_API_KEY=
# Required for community photo uploads. Configure these values in backend/.env only.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
